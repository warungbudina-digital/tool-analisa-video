VIRAL_ANALYZER_PORT=9021
# Direktori HOST yang di-mount read-only ke /data/input di dalam container.
# WAJIB path HOST (relatif ke lokasi compose, atau absolut). JANGAN isi /data/input —
# itu path DI DALAM container (sudah di-hardcode di blok environment compose).
# Salah isi bikin mount nunjuk dir root kosong -> POST /analyze balas video_not_found.
VIRAL_ANALYZER_INPUT_DIR=./data/input
ASR_MODEL=base
CLIP_MODEL=openai/clip-vit-base-patch32
