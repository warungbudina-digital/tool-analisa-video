VIRAL_ANALYZER_PORT=9021
# Direktori HOST tempat video input berada, di-mount read-only ke /data/input
# di dalam container. Isi dengan path HOST (relatif ke lokasi compose, atau absolut).
# Path di dalam container (/data/input) di-hardcode di compose, tak perlu diatur di sini.
VIRAL_ANALYZER_HOST_INPUT_DIR=./data/input
ASR_MODEL=base
CLIP_MODEL=openai/clip-vit-base-patch32
